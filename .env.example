# Copy ke .env. Paper trading (default) TIDAK butuh kredensial apa pun.

# ── MODE ─────────────────────────────────────────────────────────────────────
# Live cuma jalan kalau DUA-DUANYA di-set DAN strategi sudah `npb promote`.
NPB_MODE=paper                 # paper | live
LIVE_TRADING_ENABLED=false
BANKROLL_USD=100               # dasar sizing Kelly copytrade
NPB_DB_PATH=data/npb.db
LOOP_INTERVAL_SEC=60

# ── WALLET (cuma live) — pakai wallet KHUSUS bot, isi seperlunya, JANGAN commit ─
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=1

# ── REM RISIKO (berlaku paper & live) ────────────────────────────────────────
MAX_ORDER_USD=5                # hard cap per order (termasuk fee)
MAX_EXPOSURE_USD=100           # total di posisi belum settle
MAX_MARKET_USD=15              # per market
DAILY_LOSS_LIMIT_USD=20        # rugi 24 jam lewat ini -> stop order baru
ZOMBIE_DAYS=14

# ── FEE ──────────────────────────────────────────────────────────────────────
# -1 = pakai taker_base_fee dari CLOB per market. Kalibrasi pakai 1 fill live kecil.
FEE_RATE_OVERRIDE=-1

# ── GERBANG LIVE ─────────────────────────────────────────────────────────────
GATE_MIN_RESOLVED=200
GATE_MIN_T=2.0
GATE_MIN_ROI_CI_LOW=0.0

# ── TELEGRAM (opsional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── COPYTRADE ────────────────────────────────────────────────────────────────
COPYTRADE_ENABLED=true
TRADER_WALLETS=                # dipisah koma; kosong = kandidat dari leaderboard
CT_LEADERBOARD_POOL=100
CT_FOLLOW_TOP=15
CT_MIN_TRADER_MARKETS=30       # minimal market settle buat ngukur skill
CT_MIN_TRADER_T=2.0            # edge trader harus signifikan
CT_SHRINK_K=30
CT_STATS_REFRESH_HOURS=12
CT_MAX_RESOLUTION_LOOKUPS=150
CT_MAX_SIGNAL_AGE_SEC=600      # cuma copy trade yang umurnya <= 10 menit
CT_MIN_TRADER_USDC=50
CT_MAX_SLIPPAGE=0.02           # skip kalau kita bayar > harga trader + ini
CT_MIN_PRICE=0.05
CT_MAX_PRICE=0.95
CT_MAX_DAYS_TO_RESOLVE=30
CT_MIN_EDGE=0.01
CT_KELLY_FRACTION=0.25

# ── ARBITRAGE (basket neg-risk) ──────────────────────────────────────────────
ARB_ENABLED=true
ARB_MAX_EVENTS=1500
ARB_MIN_EDGE=0.01              # profit per set setelah fee
ARB_PREFILTER_SLACK=0.03
ARB_MAX_SETS=200
ARB_SCAN_INTERVAL_MIN=5
